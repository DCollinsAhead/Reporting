# Jira Cloud site for the Foundry Project Tracking (FPT) board
JIRA_BASE_URL=https://ahd-foundry.atlassian.net
JIRA_EMAIL=you@ahead.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT_KEY=FPT

# Origin allowed to call this proxy from a browser - the Roost page's origin
ALLOWED_ORIGIN=https://roost.ahead.com

# How long results are cached before re-querying Jira (seconds)
CACHE_TTL_SECONDS=300

PORT=3000
